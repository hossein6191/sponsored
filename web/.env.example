# The deployed Sponsored contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts), with the four demo posts read as the
# demo expects; no wallet and no network. For local work and for showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# The public source repository (https://github.com/<owner>/<name>): the footer's Source link, and the repository the
# demo creator's pinned post addresses are built from. On Vercel the repository the site was built from is used when
# this is empty (its NEXT_PUBLIC_VERCEL_GIT_* system variables).
NEXT_PUBLIC_REPO_URL=

# The commit (40 hex characters) whose posts/ the demo creator submits, as raw.githubusercontent.com serves them.
# Empty: lib/config.ts POSTS_COMMIT is used; with both empty the demo creator neither accepts nor posts.
NEXT_PUBLIC_POSTS_COMMIT=

# The demo creator's address, only when the server has no DEMO_CREATOR_KEY: the server otherwise names it from the key.
NEXT_PUBLIC_DEMO_CREATOR=

# Server only. A throwaway Studio test key for the demo creator (tools/open-demo-creator.mjs readies it). POST
# /api/demo/accept and /api/demo/post sign with it: accept() on a brief made to it, deposit() of credit when its credit
# runs out, and submit() of one of the four fixed posts in lib/demo-creator.ts. Never a key that holds anything real.
# Pasted with or without 0x, with or without quotes. Unset: the site works, and GET /api/demo/status says exactly why
# the demo creator is away.
DEMO_CREATOR_KEY=
